<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<!-- LSUIElement: true — hides from Dock and app switcher (menu bar accessory) -->
	<key>LSUIElement</key>
	<true/>
	<!-- NSPrincipalClass required for SwiftUI @main apps -->
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Accessibility usage description shown in Privacy prompt -->
	<key>NSAccessibilityUsageDescription</key>
	<string>KeydAgent uses Accessibility to inject keystrokes into the frontmost application.</string>
	<!-- Local network usage description -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>KeydAgent communicates with the iOS companion app over USB and local network.</string>
	<!-- Bonjour services advertised for AWDL discovery -->
	<key>NSBonjourServices</key>
	<array>
		<string>_keyd._tcp</string>
	</array>
</dict>
</plist>
